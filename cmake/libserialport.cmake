# Builds sigrok's libserialport (LGPL-3.0-or-later) from source. Upstream uses
# autotools, so we reproduce the handful of configure checks it needs here and
# generate its config.h ourselves.
include(FetchContent)
include(CheckStructHasMember)
include(CheckSymbolExists)
include(CheckTypeSize)
include(CheckIncludeFile)

FetchContent_Declare(libserialport
  GIT_REPOSITORY https://github.com/sigrokproject/libserialport.git
  GIT_TAG 21b3dfe5f68c205be4086469335fd2fc2ce11ed2
  SOURCE_SUBDIR _no_cmake_)
FetchContent_MakeAvailable(libserialport)
set(SP_DIR ${libserialport_SOURCE_DIR})

set(SP_SOURCES ${SP_DIR}/serialport.c ${SP_DIR}/timing.c)
set(SP_CONFIG "")
macro(sp_define name value)
  string(APPEND SP_CONFIG "#define ${name} ${value}\n")
endmacro()

sp_define(SP_PACKAGE_VERSION_MAJOR 0)
sp_define(SP_PACKAGE_VERSION_MINOR 1)
sp_define(SP_PACKAGE_VERSION_MICRO 2)
sp_define(SP_PACKAGE_VERSION_STRING "\"0.1.2\"")
sp_define(SP_LIB_VERSION_CURRENT 1)
sp_define(SP_LIB_VERSION_REVISION 1)
sp_define(SP_LIB_VERSION_AGE 1)
sp_define(SP_LIB_VERSION_STRING "\"1:1:1\"")

if(WIN32)
  list(APPEND SP_SOURCES ${SP_DIR}/windows.c)
  sp_define(SP_API "")
  sp_define(SP_PRIV "")
elseif(APPLE)
  list(APPEND SP_SOURCES ${SP_DIR}/macosx.c)
  sp_define(SP_API "__attribute__((visibility(\"default\")))")
  sp_define(SP_PRIV "__attribute__((visibility(\"hidden\")))")
  sp_define(HAVE_REALPATH 1)
  sp_define(HAVE_SYS_FILE_H 1)
  sp_define(HAVE_FLOCK 1)
  sp_define(HAVE_CLOCK_GETTIME 1)
else()
  list(APPEND SP_SOURCES ${SP_DIR}/linux.c ${SP_DIR}/linux_termios.c)
  sp_define(SP_API "__attribute__((visibility(\"default\")))")
  sp_define(SP_PRIV "__attribute__((visibility(\"hidden\")))")
  sp_define(HAVE_REALPATH 1)
  sp_define(HAVE_SYS_FILE_H 1)
  sp_define(HAVE_FLOCK 1)
  sp_define(HAVE_CLOCK_GETTIME 1)
  set(CMAKE_EXTRA_INCLUDE_FILES linux/termios.h)
  check_type_size("struct termios2" SP_TERMIOS2)
  unset(CMAKE_EXTRA_INCLUDE_FILES)
  if(HAVE_SP_TERMIOS2)
    sp_define(HAVE_STRUCT_TERMIOS2 1)
  endif()
  check_struct_has_member("struct termios2" c_ispeed linux/termios.h SP_T2_ISPEED)
  check_struct_has_member("struct termios" c_ispeed linux/termios.h SP_T_ISPEED)
  if(SP_T2_ISPEED)
    sp_define(HAVE_STRUCT_TERMIOS2_C_ISPEED 1)
    sp_define(HAVE_STRUCT_TERMIOS2_C_OSPEED 1)
    sp_define(HAVE_TERMIOS2_SPEED 1)
  endif()
  if(SP_T_ISPEED)
    sp_define(HAVE_STRUCT_TERMIOS_C_ISPEED 1)
    sp_define(HAVE_STRUCT_TERMIOS_C_OSPEED 1)
    sp_define(HAVE_TERMIOS_SPEED 1)
  endif()
  check_symbol_exists(BOTHER linux/termios.h SP_BOTHER)
  if(SP_BOTHER)
    sp_define(HAVE_DECL_BOTHER 1)
  else()
    sp_define(HAVE_DECL_BOTHER 0)
  endif()
  set(CMAKE_EXTRA_INCLUDE_FILES linux/serial.h)
  check_type_size("struct serial_struct" SP_SERIAL_STRUCT)
  unset(CMAKE_EXTRA_INCLUDE_FILES)
  if(HAVE_SP_SERIAL_STRUCT)
    sp_define(HAVE_STRUCT_SERIAL_STRUCT 1)
  endif()
endif()

set(SP_GEN_DIR ${CMAKE_BINARY_DIR}/libserialport)
file(WRITE ${SP_GEN_DIR}/config.h.tmp "/* Generated by cmake/libserialport.cmake */\n${SP_CONFIG}")
file(COPY_FILE ${SP_GEN_DIR}/config.h.tmp ${SP_GEN_DIR}/config.h ONLY_IF_DIFFERENT)

add_library(serialport STATIC ${SP_SOURCES})
target_include_directories(serialport PUBLIC ${SP_DIR} PRIVATE ${SP_GEN_DIR})
if(MSVC)
  # libserialport.h hardwires dllimport for MSVC consumers unless
  # LIBSERIALPORT_MSBUILD is set; with it, both sides agree on dllexport, which
  # is harmless when linking statically into the executable.
  string(REGEX REPLACE "#define SP_(API|PRIV)[^\n]*\n" "" SP_MSVC_CONFIG "${SP_CONFIG}")
  file(WRITE ${SP_GEN_DIR}/sp_msvc_versions.h "/* Generated */\n${SP_MSVC_CONFIG}")
  target_compile_definitions(serialport PUBLIC LIBSERIALPORT_MSBUILD)
  target_compile_options(serialport PRIVATE /FI${SP_GEN_DIR}/sp_msvc_versions.h)
else()
  target_compile_definitions(serialport PRIVATE LIBSERIALPORT_ATBUILD)
endif()
if(WIN32)
  target_link_libraries(serialport PUBLIC setupapi cfgmgr32)
  target_compile_definitions(serialport PRIVATE _CRT_SECURE_NO_WARNINGS)
elseif(APPLE)
  target_link_libraries(serialport PUBLIC "-framework IOKit" "-framework CoreFoundation")
endif()
if(MSVC)
  target_compile_options(serialport PRIVATE /w)
else()
  target_compile_options(serialport PRIVATE -w)
endif()
